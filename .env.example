# Halcerion kit .env.example — copy to .env and edit. Values are defaults.
# Anything start.sh also accepts on the command line wins from real env over this file.

# --- security (our own 9/19 lesson: never publish an unauth'd GPU endpoint) ---
# HOST=127.0.0.1 = loopback only; 0.0.0.0 requires API_KEY below (openssl rand -hex 24).
# Put values BEFORE any comment, or move comments to their own line ABOVE the value:
# `API_KEY=val  # comment` parses correctly under `source`, but grep/cut-based
# readers ingest the comment into the key (burned us in the flight 6/7 debugging).
HOST=127.0.0.1
API_KEY=

# --- serving ---
# PORT is honored by start.sh, config.yml, stop.sh and the runbook — any port
# works. NOTE: 8888 was Mia's (Flash-Next) port; flights 1-6 ran on 8893.
PORT=8888                 # default
SERVED_NAME=MiMo-V2.6-Flash-RL
DRAFT_MODE=model          # 'model' = DFlash drafter (pack author's faster pick) | 'mtp' | 'raw'
VISION=1                  # vision tower (+1.3 GiB); 0 = text only
MAX_SEQ_LEN=262144

# --- image ---
IMAGE=ghcr.io/halcerion/mimo-v2.6-flash-rl-single-dgx-spark:latest
EXL3_REF=v1.5.2

# --- memory gate (unified-memory box: OOM = whole-machine freeze) ---
NEED_HOST_GIB=70          # refuse to launch below this MemAvailable
HEALTH_TIMEOUT=1800       # cold load is ~10 min with 85 GiB of weights

# --- house rules (leave unless you know) ---
CONTAINER_NAME=halcerion-mimo-spark
PACK_DIR=                 # defaults to ~/.cache/halcerion/mimo-v2.6-flash-rl-exl3
FOREGROUND=0              # 1 = ./start.sh stays attached following container logs (systemd unit shape)
STOP_GRACE_S=30           # ./stop.sh grace window for in-flight streams (SIGTERM -> SIGKILL)
